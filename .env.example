# Environment variables for Manufacturing QC Agent
# Copy this to .env and fill in your values

# =============================================================================
# LLM API Keys (at least one required)
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# =============================================================================
# Model Paths (optional - for local model inference)
# =============================================================================
# QC_MODEL_PATH=./models/defect_detector.tflite
# QC_KNOWLEDGE_BASE_PATH=./knowledge/embeddings

# =============================================================================
# S3 Storage (optional - for file persistence)
# =============================================================================
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=qc-agent-storage
# QC_ENABLE_S3_STORAGE=True

# =============================================================================
# MongoDB (optional - for session persistence)
# =============================================================================
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB=qc_agent
# MONGODB_COLLECTION=sessions
# QC_ENABLE_MONGODB=True
